    {
      "id": "DUk5TyfDnLiVxhrmH-kbQ",
      "type": "text",
      "x": 311.11809063714327,
      "y": 2132.7727065347744,
      "width": 1058.8794250488281,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2G",
      "roundness": null,
      "seed": 1306574032,
      "version": 564,
      "versionNonce": 1471780560,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794727492636,
      "link": null,
      "locked": false,
      "text": "Why we use async in MCP ?\n\n- in mcp code, we use async/await to prevent long-running tasks from freezing server and blocking AI agent.\n- because mcp servers handle i/o heavy operations, standard sync code would force LLM to wait completely\n  idle for one task to finish before it could do anything else.\n- using async allows server to remain highly responsive and process multiple instructions concurrently.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why we use async in MCP ?\n\n- in mcp code, we use async/await to prevent long-running tasks from freezing server and blocking AI agent.\n- because mcp servers handle i/o heavy operations, standard sync code would force LLM to wait completely\n  idle for one task to finish before it could do anything else.\n- using async allows server to remain highly responsive and process multiple instructions concurrently.",
      "autoResize": false,
      "lineHeight": 1.25
    },
